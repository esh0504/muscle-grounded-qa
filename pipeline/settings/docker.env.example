# Compose environment — copy to the PIPELINE ROOT as `.env` and edit the values.
#   cp settings/docker.env.example .env
# docker compose reads `.env` from the root, next to docker-compose.yml.
# Every line below is active — change the value, don't comment it out.

# --- Run as your own account (shared servers) ---
# Container processes run with these ids, so everything written to DATA_DIR is
# owned by you instead of root. Set them to your real ids (`id -u` / `id -g`):
DOCKER_UID=1000
DOCKER_GID=1000

# --- Naming (image / container / compose project) ---
COMPOSE_PROJECT_NAME=tongueqa
IMAGE_NAME=tongueqa/pipeline
IMAGE_TAG=latest
CONTAINER_NAME=tongueqa_pipeline

# Where all pipeline data lives on the host (mounted at /data in the container).
# ~1 TB is needed for the full 295k run (verts+nodes shards + indexes + QA).
# Create it as your own account BEFORE the first run: mkdir -p <DATA_DIR>
DATA_DIR=./data

# ArtiSynth refs baked into the image (record these for a release!)
ARTISYNTH_REF=master
MODELS_REF=master

# Step 3 parallelism: NPROC workers x ~6GB heap each
NPROC=4
JVM_XMX=6g

# Step 5
FEAT_WORKERS=2
LANGS=ko en
