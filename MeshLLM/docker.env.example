# MeshLLM compose environment — copy to `.env` in this folder and edit the values.
#   cp docker.env.example .env
# Every line below is active — change the value, don't comment it out.

# --- Run as your own account (shared servers) ---
# Container processes run with these ids, so DATA/outputs/.cache are owned by
# you instead of root. Set them to your real ids (`id -u` / `id -g`):
DOCKER_UID=1000
DOCKER_GID=1000

# --- Naming ---
COMPOSE_PROJECT_NAME=meshllm
IMAGE_NAME=meshllm/baseline
IMAGE_TAG=latest
CONTAINER_NAME=meshllm

# --- Host paths (mounted into the container) ---
# Dataset root -> /workspace/DATA  (layout: docs/data.md).
# Easiest: point this at the 3DTongueQA pipeline's DATA_DIR — the scripts
# detect that layout and link DATA/mesh automatically (no copying).
DATA_DIR=./DATA

# Training outputs (checkpoints, eval reports, logs) -> /workspace/outputs
# Point this at a disk with room — Stage-2 checkpoints are ~326MB each.
OUTPUT_DIR=./outputs

# Model cache (Qwen3-8B download, ~16GB) -> /workspace/.cache
CACHE_DIR=./.cache

# --- GPU / logging ---
NVIDIA_VISIBLE_DEVICES=all
WANDB_MODE=offline
WANDB_API_KEY=
